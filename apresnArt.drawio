  <diagram name="Page-1" id="1SJ0bu9kY8x4j4DuMWKP">
    <mxGraphModel dx="2562" dy="687" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="VGilzbH-NUcZVm5pDlqU-11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontColor=#333333;" value="" vertex="1">
          <mxGeometry height="490" width="130" x="1094" y="260" as="geometry" />
        </mxCell>
        <mxCell id="VGilzbH-NUcZVm5pDlqU-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;h3 style=&quot;text-align: justify;&quot;&gt;1. Requisitos funcionais — o que o sistema faz&lt;/h3&gt;&lt;ul&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;Consultar saldo:&lt;/strong&gt; retornar o saldo atualizado de uma conta.&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;Registrar crédito e débito:&lt;/strong&gt; receber uma operação com conta, valor e identificador único.&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;Validar operações:&lt;/strong&gt; verificar se a conta existe e está ativa, se o valor é válido e se a operação é permitida.&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;Impedir saldo negativo:&lt;/strong&gt; rejeitar qualquer débito que deixe a conta com saldo abaixo de zero.&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;Registrar movimentações:&lt;/strong&gt; manter o histórico de créditos, débitos, estornos e seus resultados.&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;Consultar operação:&lt;/strong&gt; permitir verificar se uma movimentação foi aceita, rejeitada ou ainda está sendo processada.&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;Lidar com reenvios:&lt;/strong&gt; reconhecer uma solicitação repetida pelo mesmo identificador e não aplicá-la duas vezes.&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;Auditar alterações:&lt;/strong&gt; registrar quem solicitou cada operação, quando ela ocorreu e qual foi o resultado.&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;Controlar operações simultâneas:&lt;/strong&gt; garantir que atualizações concorrentes na mesma conta sejam processadas sem deixar o saldo negativo ou aplicar movimentações duplicadas.&lt;/li&gt;&lt;/ul&gt;&lt;h3 style=&quot;text-align: justify;&quot;&gt;2. Requisitos não funcionais — como o sistema se comporta&lt;/h3&gt;&lt;ul&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;Capacidade:&lt;/strong&gt; sustentar &lt;strong&gt;1.000 TPS&lt;/strong&gt; e suportar &lt;strong&gt;100 mil usuários simultâneos&lt;/strong&gt;. O teste de carga deve avaliar as duas metas ao mesmo tempo.&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;Perfil de carga:&lt;/strong&gt; definir se os 1.000 TPS incluem consultas e atualizações ou representam apenas alterações de saldo.&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;Latência:&lt;/strong&gt; definir metas de resposta. Como ponto de partida, proponho que 95% das operações respondam em até 200 ms e 99% em até 500 ms, sob a carga prevista.&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;Integridade do saldo:&lt;/strong&gt; não perder nem aplicar mais de uma vez uma movimentação confirmada.&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;Consistência:&lt;/strong&gt; uma consulta feita após uma atualização confirmada deve retornar o saldo atualizado.&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;Prioridade de consistência:&lt;/strong&gt; se uma falha impedir o sistema de confirmar o saldo correto, ele deve recusar temporariamente a operação em vez de retornar um saldo possivelmente desatualizado.&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;Disponibilidade:&lt;/strong&gt; definir uma meta de disponibilidade para o serviço. Durante uma falha que impeça garantir a consistência, a prioridade será manter os dados corretos.&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;Durabilidade e recuperação:&lt;/strong&gt; definir o tempo máximo para recuperar o serviço após uma falha e garantir que operações confirmadas não sejam perdidas.&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;Segurança e privacidade:&lt;/strong&gt; proteger dados pessoais e financeiros contra acesso, alteração ou divulgação não autorizados. Autenticar usuários, verificar suas permissões em cada operação e proteger dados em trânsito e armazenados.&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;Auditoria e monitoramento:&lt;/strong&gt; permitir acompanhar volume, latência, erros, operações pendentes e tentativas de acesso suspeitas, sem expor dados sensíveis nos logs.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="30" width="1410" x="-480" y="410" as="geometry" />
        </mxCell>
        <mxCell id="VGilzbH-NUcZVm5pDlqU-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Camada de entrada e protecao" vertex="1">
